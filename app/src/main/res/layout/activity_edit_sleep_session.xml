<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_night_gradient">

    <!-- Header row -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="←"
            android:textSize="20sp"
            android:textColor="#FFAACCEE"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="18sp"
            android:textColor="#FFDDEEFF"
            android:gravity="center"
            android:fontFamily="sans-serif-light" />

        <TextView
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Save"
            android:textSize="14sp"
            android:textColor="#FF7EB8FF"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>

    <!-- Edit rows card -->
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_settings_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp">

        <!-- Bed time row -->
        <LinearLayout
            android:id="@+id/rowBedtime"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:focusable="true"
            android:clickable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bed time"
                android:textSize="14sp"
                android:textColor="#FFAACCEE" />

            <TextView
                android:id="@+id/tvBedtime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="#FFDDEEFF"
                android:fontFamily="sans-serif-thin" />

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="20sp"
                android:textColor="#44AACCEE"
                android:gravity="center"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#11AACCEE" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" />

        <!-- Wake time row -->
        <LinearLayout
            android:id="@+id/rowWakeTime"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:focusable="true"
            android:clickable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Wake time"
                android:textSize="14sp"
                android:textColor="#FFAACCEE" />

            <TextView
                android:id="@+id/tvWakeTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="#FFDDEEFF"
                android:fontFamily="sans-serif-thin" />

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="20sp"
                android:textColor="#44AACCEE"
                android:gravity="center"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#11AACCEE" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" />

        <!-- Wakings counter row -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Wakings"
                android:textSize="14sp"
                android:textColor="#FFAACCEE" />

            <TextView
                android:id="@+id/btnWakingsDown"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="−"
                android:textSize="22sp"
                android:textColor="#FF7EB8FF"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/tvWakings"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="20sp"
                android:textColor="#FFDDEEFF"
                android:gravity="center"
                android:fontFamily="sans-serif-thin" />

            <TextView
                android:id="@+id/btnWakingsUp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="+"
                android:textSize="22sp"
                android:textColor="#FF7EB8FF"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hint text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manual edits override app-tracked times."
        android:textSize="11sp"
        android:textColor="#33AACCEE"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp" />

</LinearLayout>
