<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Same day/night background as LockScreen, frozen at night frame via code -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:lottie_fileName="day_night_cycle.json"
        app:lottie_autoPlay="false"
        app:lottie_loop="false" />

    <!-- Bottom gradient scrim — identical to lock screen -->
    <View
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_scrim" />

    <!-- Bottom UI: phase title, dots, elapsed, action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="56dp"
        android:paddingTop="16dp">

        <TextView
            android:id="@+id/tvPhaseTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Breathe slowly"
            android:textSize="26sp"
            android:textColor="#FFF8F0"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <View
                android:id="@+id/dot1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_active"
                android:layout_marginEnd="8dp" />

            <View
                android:id="@+id/dot2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_inactive"
                android:layout_marginEnd="8dp" />

            <View
                android:id="@+id/dot3"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_inactive" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvElapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="#55FFFFFF"
            android:fontFamily="sans-serif-thin"
            android:letterSpacing="0.05"
            android:layout_marginBottom="32dp" />

        <TextView
            android:id="@+id/tvSleepyAgain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="I'm sleepy again"
            android:textSize="15sp"
            android:textColor="#CCFFFFFF"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.05"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvLeaveBed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Leave the bed"
            android:textSize="15sp"
            android:textColor="#CCFFFFFF"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.05"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
