<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_night_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="48dp"
            android:paddingBottom="12dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="←"
                android:textSize="20sp"
                android:textColor="#FFAACCEE"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sleep Diary"
                android:textSize="22sp"
                android:textColor="#FFDDEEFF"
                android:gravity="center"
                android:fontFamily="sans-serif-light" />

            <View android:layout_width="40dp" android:layout_height="40dp" />
        </LinearLayout>

        <!-- Chart legend -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical|end"
            android:paddingEnd="20dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textSize="10sp"
                android:textColor="#AA7EB8FF"
                android:layout_marginEnd="3dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bedtime"
                android:textSize="10sp"
                android:textColor="#44AACCEE"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textSize="10sp"
                android:textColor="#AA4DCCAA"
                android:layout_marginEnd="3dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wake"
                android:textSize="10sp"
                android:textColor="#44AACCEE" />

        </LinearLayout>

        <!-- 7-day trend chart -->
        <com.sleepguard.SleepChartView
            android:id="@+id/sleepChart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- Tap hint -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap a night to view or edit"
            android:textSize="11sp"
            android:textColor="#22AACCEE"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="2dp" />

        <!-- Section divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="#15AACCEE" />

        <!-- Scrollable day list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:clipToPadding="false" />

        <!-- Empty state -->
        <TextView
            android:id="@+id/tvEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="No sleep sessions yet.\nActivate SleepGuard tonight to start tracking."
            android:textSize="14sp"
            android:textColor="#44AACCEE"
            android:gravity="center"
            android:padding="32dp" />

        <!-- Summary stats row 1 -->
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/bg_settings_panel"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:id="@+id/tvStat1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="26sp" android:textColor="#FFFFFFFF" android:fontFamily="sans-serif-thin" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7-day avg" android:textSize="11sp" android:textColor="#55AACCEE" />
            </LinearLayout>

            <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:id="@+id/tvStat2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="26sp" android:textColor="#FFFFFFFF" android:fontFamily="sans-serif-thin" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="avg quality" android:textSize="11sp" android:textColor="#55AACCEE" />
            </LinearLayout>

            <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:id="@+id/tvStat3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="26sp" android:textColor="#FFFFFFFF" android:fontFamily="sans-serif-thin" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="nights" android:textSize="11sp" android:textColor="#55AACCEE" />
            </LinearLayout>
        </LinearLayout>

        <!-- Summary stats row 2 -->
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/bg_settings_panel"
            android:padding="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="32dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:id="@+id/tvStat4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="26sp" android:textColor="#FFFFFFFF" android:fontFamily="sans-serif-thin" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="avg onset" android:textSize="11sp" android:textColor="#55AACCEE" />
            </LinearLayout>

            <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:id="@+id/tvStat5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="26sp" android:textColor="#FFFFFFFF" android:fontFamily="sans-serif-thin" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="avg wakings" android:textSize="11sp" android:textColor="#55AACCEE" />
            </LinearLayout>

            <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:id="@+id/tvStat6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="26sp" android:textColor="#FFFFFFFF" android:fontFamily="sans-serif-thin" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="avg restedness" android:textSize="11sp" android:textColor="#55AACCEE" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
